# Copy to .env and fill in. Used by docker-compose.prod.yml. NEVER commit .env.
# (.env is already in .gitignore.)

# ---- Public URL / domain ---------------------------------------------------
# A free subdomain works fine (e.g. DuckDNS). Point its DNS A record at this VM's
# public IP, then set both below. PUBLIC_URL must include https://.
DOMAIN=yourname.duckdns.org
PUBLIC_URL=https://yourname.duckdns.org
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices (optional but recommended)

# ---- Postgres --------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---- Secrets (GENERATE these — do NOT ship the dev defaults) ----------------
# JWT_SECRET:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# FERNET_KEY (encrypts stored provider keys at rest):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- Embeddings ------------------------------------------------------------
# EMBEDDING_DIM is FIXED at first boot (per-tenant vector dimension). 768 = nomic-embed-text.
# Changing it later requires a fresh database. Leave provider 'fake' (seed default);
# real agents use the local Ollama embedder configured in the dashboard.
EMBEDDING_DIM=768
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small

# ---- CORS ------------------------------------------------------------------
# Single-domain deploy is same-origin, so this is mostly belt-and-suspenders.
# Defaults to PUBLIC_URL via compose; override here only to allow extra origins.
# CORS_ORIGINS=https://yourname.duckdns.org

# ---- Demo seed -------------------------------------------------------------
# Keep false in production (the seed creates a demo@mneme.dev / demo1234 account).
# Sign up your real account via the dashboard instead.
SEED_ON_BOOT=false

# ---- Razorpay billing (optional; only if charging) -------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- NOT set here --------------------------------------------------------- #
# The Ollama Cloud LLM key is stored PER-AGENT, encrypted, via the dashboard
# (Agents -> LLM API key). It never goes in this file or any env var.
