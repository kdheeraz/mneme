# Production image: compiles the app and serves it with `next start`.
# NEXT_PUBLIC_API_URL must be present at BUILD time — Next.js inlines NEXT_PUBLIC_*
# into the browser bundle during `next build`, not at runtime.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

EXPOSE 3000
# Bind all interfaces so Caddy (other container) can reach it.
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
